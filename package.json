{
  "name": "modularchat-pierogiedition",
  "version": "3.4.2",
  "description": "ModularChat (Pierogi Edition): local Rust server with encrypted memory, pluggable OpenAI-compatible model providers and an Android app. This package only holds the start, test and verification scripts.",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File start-server.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File start-server.ps1 -Sandbox -NoUpstream",
    "build:rust": "cargo build --manifest-path server-rust/Cargo.toml --bins",
    "test": "node scripts/run-all-tests.mjs",
    "test:all": "node scripts/run-all-tests.mjs --all",
    "test:unit": "node scripts/run-all-tests.mjs --unit",
    "test:fast": "node scripts/run-all-tests.mjs --unit",
    "test:integration": "node scripts/run-all-tests.mjs --integration",
    "test:rust": "cargo test --manifest-path server-rust/Cargo.toml",
    "test:legacy": "node --test --test-concurrency=1 tests/*.test.js tests/rust-runtime.mjs tests/rust-privacy.mjs",
    "validate-routes": "node scripts/validate-routes.mjs"
  }
}
