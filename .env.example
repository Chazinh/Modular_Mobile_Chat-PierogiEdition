# Environment variables read by the Rust server (server-rust/src/config.rs, providers.rs and local.rs).
# The server does NOT load a .env file: set them in your shell or system before running start-server.ps1.

# ---- Model providers ----
# Recommended: a providers.json file (see providers.example.json) in the data directory, or point to it:
# MC_PROVIDERS_FILE=C:\path\to\providers.json
# Without a providers file, a single OpenAI-compatible provider is configured from these variables:
# MC_UPSTREAM_URL=http://127.0.0.1:20128/v1
# MC_UPSTREAM_API_KEY=sk-...
# (NINEROUTER_URL / NINEROUTER_API_KEY are accepted as aliases. Production defaults to http://127.0.0.1:20128/v1.)

# ---- Server ----
# PORT=3000
# HOST=0.0.0.0
# DATA_DIR=C:\path\to\data            (start-server.ps1 uses MODULARCHAT_DATA or .\data)
# MODULARCHAT_DATA=C:\path\to\data
# Devices other than this PC must pair with a 6-digit code. 0 disables pairing (loopback only, not recommended).
# REQUIRE_PAIRING=1
# MC_MAX_GENERATIONS=4

# ---- Local memory models (llama.cpp; optional) ----
# MC_LOCAL_HOME=C:\path\to\ModularChat-local
# LLAMA_SERVER=C:\path\to\llama-server.exe
# LOCAL_CHAT_MODEL=C:\path\to\models\Qwen3.5-4B-Q5_K_M.gguf
# LOCAL_EMBED_MODEL=C:\path\to\models\embeddinggemma-300M-Q8_0.gguf
# LOCAL_IDLE_MS=900000
